<ui:FluentWindow x:Class="CalyRecallNative.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:CalyRecallNative.Views.Pages"
                 Title="CalyRecall"
                 Width="1050"
                 Height="700"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Assets/CalyRecall-Icon.ico">

    <ui:FluentWindow.Resources><SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#b28df9" />
        <SolidColorBrush x:Key="NavigationViewItemSelectionIndicatorForeground" Color="#b28df9" />
        <SolidColorBrush x:Key="NavigationViewItemSelectionIndicatorBrush" Color="#b28df9" />
        <SolidColorBrush x:Key="NavigationViewItemIndicatorForeground" Color="#b28df9" />
        <SolidColorBrush x:Key="NavigationViewItemIndicatorBrush" Color="#b28df9" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="CalyRecall">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/CalyRecall-Icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <ui:NavigationView x:Name="RootNavigation"
                               PaneDisplayMode="Left"
                               OpenPaneLength="220"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="{DynamicResource Nav_Dashboard}" TargetPageType="{x:Type pages:DashboardPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{DynamicResource Nav_Backups}" TargetPageType="{x:Type pages:RestorePage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="History24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{DynamicResource Nav_Cloud}" TargetPageType="{x:Type pages:CloudPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Cloud24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="{DynamicResource Nav_Settings}" TargetPageType="{x:Type pages:SettingsPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>

                <ui:NavigationView.PaneFooter>
                    <StackPanel Margin="16,16,16,16" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding ViewModel.ConnectionStatusColor}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ViewModel.ConnectionStatusText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:NavigationView.PaneFooter>
            </ui:NavigationView>
            
            <ui:SnackbarPresenter x:Name="RootSnackbar" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,24" /><Border x:Name="CustomToastBorder" Background="#9b7dd9" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Padding="16,12" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="1000">
                <Border.RenderTransform>
                    <TranslateTransform Y="20" x:Name="CustomToastTransform" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="CustomToastIcon" Symbol="Checkmark24" Foreground="White" FontSize="24" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock x:Name="CustomToastTitle" Text="Atualizado" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,2" />
                        <TextBlock x:Name="CustomToastDesc" Text="O banco de dados já está na versão mais recente!" Foreground="White" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid><Grid Grid.RowSpan="2" Visibility="{Binding ViewModel.IsSemiAutoModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1000">
            <Border Background="#A0000000" />
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <TextBlock Text="{DynamicResource MainWindow_DetectedClose}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource MainWindow_SaveNow}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                    
                    <Border CornerRadius="8" ClipToBounds="True" Width="300" Height="140" Margin="0,0,0,16" HorizontalAlignment="Center" Background="#1c1c1c">
                        <Image Source="{Binding ViewModel.PendingSemiAutoGameCover}" Stretch="UniformToFill" />
                    </Border>
                    
                    <TextBlock Text="{Binding ViewModel.PendingSemiAutoGameName}" FontSize="18" FontWeight="SemiBold" Foreground="#b28df9" HorizontalAlignment="Center" Margin="0,0,0,24" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <ui:Button Grid.Column="0" Content="{DynamicResource MainWindow_DiscardBtn}" Command="{Binding ViewModel.DiscardSemiAutoBackupCommand}" Appearance="Secondary" HorizontalAlignment="Stretch" />
                        <ui:Button Grid.Column="2" Content="{DynamicResource MainWindow_SaveBackupBtn}" Command="{Binding ViewModel.ConfirmSemiAutoBackupCommand}" Appearance="Primary" Background="#b28df9" BorderBrush="#b28df9" Foreground="Black" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid><Grid Grid.RowSpan="2" x:Name="RestoreModalOverlay" Background="#A0000000" Visibility="{Binding ViewModel.RestoreVM.IsRestoreModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1001"><Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.RestoreVM.IsRestoreModalOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <Grid><StackPanel Visibility="{Binding ViewModel.RestoreVM.IsConfirmState, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="48" Foreground="#FFB900" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="{DynamicResource Restore_ModalRestoreTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ViewModel.RestoreVM.SelectedRestoreItem.GameName, StringFormat='\{0\}'}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Content="{DynamicResource Restore_CancelBtn}" Command="{Binding ViewModel.RestoreVM.CancelRestoreCommand}" HorizontalAlignment="Stretch" Appearance="Secondary" />
                            <ui:Button Grid.Column="2" Content="{DynamicResource Restore_RestoreBtn}" Command="{Binding ViewModel.RestoreVM.ConfirmRestoreCommand}" HorizontalAlignment="Stretch" Appearance="Primary" Background="#b28df9" BorderBrush="#b28df9" Foreground="Black" />
                        </Grid>
                    </StackPanel><StackPanel Visibility="{Binding ViewModel.RestoreVM.IsProgressState, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="64" Height="64" Foreground="#b28df9" HorizontalAlignment="Center" Margin="0,0,0,24" />
                        <TextBlock Text="{DynamicResource Restore_RestoringTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Restore_RestoringDesc}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel><StackPanel Visibility="{Binding ViewModel.RestoreVM.IsSuccessState, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="64" Foreground="#107C10" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="{DynamicResource Restore_RestoreCompleteTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="{DynamicResource Restore_RestoreCompleteDesc}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />
                        <ui:Button Content="{DynamicResource Restore_DoneBtn}" Command="{Binding ViewModel.RestoreVM.CancelRestoreCommand}" HorizontalAlignment="Stretch" Appearance="Primary" Background="#b28df9" BorderBrush="#b28df9" Foreground="Black" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid><Grid Grid.RowSpan="2" x:Name="DeleteModalOverlay" Background="#A0000000" Visibility="{Binding ViewModel.RestoreVM.IsDeleteModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1002">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.RestoreVM.IsDeleteModalOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Delete24" FontSize="48" Foreground="#E81123" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="{DynamicResource Restore_ModalDeleteTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ViewModel.RestoreVM.DeleteModalMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="{DynamicResource Restore_CancelBtn}" Command="{Binding ViewModel.RestoreVM.CancelDeleteCommand}" HorizontalAlignment="Stretch" Appearance="Secondary" />
                        <ui:Button Grid.Column="2" Content="{DynamicResource Restore_DeleteBtn}" Command="{Binding ViewModel.RestoreVM.ConfirmDeleteCommand}" HorizontalAlignment="Stretch" Appearance="Danger" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid><Grid Grid.RowSpan="2" x:Name="EditModalOverlay" Background="#A0000000" Visibility="{Binding ViewModel.RestoreVM.IsEditModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1003">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.RestoreVM.IsEditModalOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Edit24" FontSize="48" Foreground="#b28df9" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="{DynamicResource Restore_ModalEditTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />
                    
                    <TextBlock Text="{DynamicResource Restore_EditNameLabel}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <ui:TextBox Text="{Binding ViewModel.RestoreVM.EditDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                    
                    <TextBlock Text="{DynamicResource Restore_EditFolderLabel}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <ui:TextBox Text="{Binding ViewModel.RestoreVM.EditFolderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                    <TextBlock Text="Capa Customizada (URL)" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding ViewModel.RestoreVM.EditCustomCoverUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://..." />
                        <ui:Button Grid.Column="2" Content="Auto-buscar" Command="{Binding ViewModel.RestoreVM.AutoSearchCoverCommand}" Appearance="Secondary" Icon="{ui:SymbolIcon Search24}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="{DynamicResource Restore_CancelBtn}" Command="{Binding ViewModel.RestoreVM.CancelEditCommand}" HorizontalAlignment="Stretch" Appearance="Secondary" />
                        <ui:Button Grid.Column="2" Content="{DynamicResource Restore_SaveBtn}" Command="{Binding ViewModel.RestoreVM.ConfirmEditCommand}" HorizontalAlignment="Stretch" Appearance="Primary" Background="#b28df9" BorderBrush="#b28df9" Foreground="Black" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid><Grid Grid.RowSpan="2" x:Name="ZipProgressModalOverlay" Background="#A0000000" Visibility="{Binding ViewModel.RestoreVM.IsZipProgressModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1004">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.RestoreVM.IsZipProgressModalOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" MinWidth="420" MaxWidth="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Archive24" FontSize="48" Foreground="#b28df9" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding ViewModel.RestoreVM.ZipProgressTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />
                    
                    <ProgressBar Value="{Binding ViewModel.RestoreVM.ZipProgressValue}" Height="8" Margin="0,0,0,8" Foreground="#b28df9" />
                    <TextBlock Text="{Binding ViewModel.RestoreVM.ZipProgressValue, StringFormat='\{0\}%'}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />

                    <ui:Button Content="{DynamicResource Zip_CancelBtn}" Command="{Binding ViewModel.RestoreVM.CancelZipProgressCommand}" HorizontalAlignment="Stretch" Appearance="Secondary" />
                </StackPanel>
            </Border>
        </Grid><Grid Grid.RowSpan="2" x:Name="CloudProgressModalOverlay" Background="#A0000000" Visibility="{Binding ViewModel.CloudVM.IsUploadModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1005">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.CloudVM.IsUploadModalOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" MinWidth="420" MaxWidth="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="48" Foreground="#b28df9" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding ViewModel.CloudVM.UploadProgressTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />
                    
                    <ProgressBar Value="{Binding ViewModel.CloudVM.UploadProgressValue}" Height="8" Margin="0,0,0,8" Foreground="#b28df9" />
                    <TextBlock Text="{Binding ViewModel.CloudVM.UploadProgressValue, StringFormat='\{0:F1\}%'}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />

                    <ui:Button Content="{DynamicResource Zip_CancelBtn}" Command="{Binding ViewModel.CloudVM.CancelUploadCommand}" HorizontalAlignment="Stretch" Appearance="Secondary" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
