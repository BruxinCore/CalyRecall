<Application x:Class="CalyRecallNative.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#9b7dd9" />
            <SolidColorBrush x:Key="SystemFillColorInfoBrush" Color="#9b7dd9" />
            <SolidColorBrush x:Key="SystemFillColorDangerBrush" Color="#9b7dd9" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
